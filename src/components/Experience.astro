---
import SectionWrapper from "./SectionWrapper.astro";
import RoleComponent from "./RoleComponent.astro";

const experiences = [
  {
    startDate: "Nov. 2025",
    endDate: "Oct. 2026",
    role: "DevOps Engineer Intern",
    company: "Silpa Consulting LLC",
    href: "https://silpaconsulting.com/",
    description:
      "Automated CI/CD pipelines, containerized infrastructure, \
      and developer tooling for seamless deployment and testing.",
    technologies: ["Github Actions", "Docker", "Bash", "Go", "Python"],
  },
  {
    startDate: "Mar. 2025",
    endDate: "Nov. 2026",
    role: "Full-Stack Engineer Intern",
    company: "Artisan Technologies",
    href: "https://www.artisanautomation.co/",
    description:
      "Developed and maintained full-stack applications using modern web technologies, \
      ensuring a responsive and user-friendly experience.",
    technologies: ["C#", ".NET", "JavaScript", "React", "Next.js", "Docker"],
  },
  {
    startDate: "Aug. 2025",
    endDate: "May 2026",
    role: "Full-Stack Engineer",
    company: "Octane",
    description:
      "Sponsored senior project to develop a custom full-stack application to replace and automate spreadsheet for a small business.",
    technologies: [
      "C#",
      ".NET",
      "JavaScript",
      "React",
      "Next.js",
      "Docker",
      "Jenkins",
      "AWS",
    ],
  },
];
---

<SectionWrapper id="experience" aria-label="Work experience">
  <div
    class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-slate-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
  >
    <h2
      class="text-sm font-bold uppercase tracking-widest text-slate-200 lg:sr-only"
    >
      Experience
    </h2>
  </div>

  <div>
    <ol class="group/list">
      {experiences.map((experience) => <RoleComponent {...experience} />)}
    </ol>
  </div>
</SectionWrapper>
