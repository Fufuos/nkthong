---
import Layout from "@layouts/Layout.astro";
import About from "@components/About.astro";
import Projects from "@components/Projects.astro";
import Experience from "@components/Experience.astro";
import Hero from "@components/Hero.astro";
import Navbar from "@components/Navbar.astro";
import SocialLinks from "@components/SocialLinks.astro";
---

<Layout>
  <div
    class="mx-auto min-h-screen max-w-7xl px-6 py-12 font-sans md:px-12 md:py-16 lg:py-0"
  >
    <div class="lg:flex lg:justify-between lg:gap-4">
      <header
        class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24"
      >
        <div>
          <Hero />
          <Navbar />
          <SocialLinks />
        </div>
      </header>

      <main class="pt-24 w-[52%] py-24">
        <div>
          <About />
          <Experience />
          <Projects />
        </div>
      </main>
    </div>
  </div>
</Layout>;
