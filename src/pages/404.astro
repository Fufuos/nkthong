---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404: Page Not Found">
  <div class="flex min-h-screen items-center justify-center px-6">
    <div class="flex items-center">
      <h1
        class="inline-block border-r border-slate-700 pr-6 text-2xl font-medium leading-12.25"
      >
        404
      </h1>

      <div class="inline-block pl-6">
        <h2 class="text-base font-normal text-slate-300">
          This page could not be found.
        </h2>

        <div class="mt-3">
          <a
            href="/"
            class="group inline-flex items-center text-sm font-medium text-slate-400 transition-colors hover:text-slate-100"
          >
            <span
              class="inline-flex items-center gap-2 rounded-md border border-slate-700 bg-slate-800/50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-slate-200 transition-all hover:border-indigo-400/50 hover:bg-slate-800 hover:text-indigo-300"
              >Back to home</span
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
