---
import "@styles/global.css";
import BackgroundEffects from "@components/BackgroundEffects.astro";
import Spotlight from "@components/Spotlight.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nicholas Thong's personal website" />
    <meta
      name="keywords"
      content="Nicholas Thong, personal website, portfolio, developer"
    />

    <link rel="icon" type="image/png" href="/icon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>Nicholas Thong</title>
  </head>

  <body
    class="bg-slate-900 leading-relaxed text-slate-400 antialiased selection:bg-indigo-300 selection:text-indigo-900"
  >
    <Spotlight />
    <BackgroundEffects />
    <div
      class="mx-auto min-h-screen max-w-7xl px-6 py-12 font-sans md:px-12 md:py-16 lg:py-0"
    >
      <slot />
    </div>
  </body>
</html>
